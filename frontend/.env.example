# Generate with `openssl rand -base64 32`.
AUTH_SECRET=

# Clerk manages registered Medix accounts. Create a development application at
# https://dashboard.clerk.com and copy both values from its API Keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Legacy Auth.js social providers are used only when Clerk is not configured.
# With Clerk enabled, configure Apple, GitHub, and Google in the Clerk Dashboard.
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local or hosted PostgreSQL connection string.
POSTGRES_URL=postgresql://medix:medix@127.0.0.1:5432/medix

# Optional. Enables resumable streams when configured.
REDIS_URL=

# Optional. Required only by the current hosted attachment-upload route.
BLOB_READ_WRITE_TOKEN=

# Medix FastAPI service used by procedure-search and image-analysis tools.
MEDIX_API_URL=http://127.0.0.1:5001

# Direct Groq access for chat generation and titles only. Speech is generated
# locally by Kokoro through the Medix FastAPI service.
GROQ_API_KEY=

# Local Qwen generation option shown alongside GPT-OSS in the model picker.
# The Ollama service must be running and the configured model must be installed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b-q4_K_M

# Optional development-only shortcut. A database-backed local user is created.
# This setting is ignored when NODE_ENV=production.
LOCAL_AUTH_BYPASS=false
